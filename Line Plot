# E-Commerce Monthly Sales Trend: (Line Plot)

months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
         "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
sales = [12000, 15000, 13500, 18000, 22000, 19500,
        24000, 21000, 26000, 28000, 35000, 32000]
plt.plot(months,sales,marker="o")
plt.xlabel("Months")
plt.ylabel("Sales")
plt.title("E-Commerce Monthly Sales Trend")
plt.fill_between(months,sales,alpha=0.5)
plt.grid(True)
plt.show()
