# Temp & Rain Analysis: (Sub Plot)

months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
          "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
temperature = [25, 27, 30, 33, 35, 34, 32, 31, 30, 29, 27, 25]
rainfall = [20, 15, 10, 40, 80, 120, 150, 140, 100, 200, 180, 50]
fig, ax = plt.subplots(2, 1, figsize=(10, 8))

# Temperature Sub Plot
ax[0].plot(months, temperature, marker="o")
ax[0].set_title("Monthly Temperature Analysis")
ax[0].set_xlabel("Month")
ax[0].set_ylabel("Temperature (°C)")
ax[0].grid(True)

# Rainfall Sub Plot
ax[1].bar(months, rainfall)
ax[1].set_title("Monthly Rainfall Analysis")
ax[1].set_xlabel("Month")
ax[1].set_ylabel("Rainfall (mm)")
ax[1].grid(True)


# Display the plots
plt.show()
