#Stock Market Analysis: (Multi Plot In Single Fig)


days = list(range(1, 31))
company_a = [100, 101, 102, 101, 103, 104, 105, 106, 105, 107,
            108, 109, 110, 109, 111, 112, 113, 114, 115, 116,
            117, 118, 119, 120, 121, 122, 123, 124, 125, 126]

company_b = [120, 119, 121, 120, 122, 121, 123, 124, 122, 123,
             124, 125, 124, 126, 125, 127, 128, 127, 129, 130,
             129, 131, 132, 131, 133, 134, 135, 134, 136, 137]

company_c = [ 80, 81, 82, 83, 82, 84, 85, 86, 87, 88,
             89, 90, 91, 92, 93, 94, 95, 96, 97, 98,
             99, 100, 101, 102, 103, 104, 105, 106, 107, 108]

growth_a = ((company_a[-1] - company_a[0]) / company_a[0]) * 100
growth_b = ((company_b[-1] - company_b[0]) / company_b[0]) * 100
growth_c = ((company_c[-1] - company_c[0]) / company_c[0]) * 100
growth = { "Company A": growth_a,"Company B": growth_b,"Company C": growth_c}
highest_company = max(growth, key=growth.get)
plt.figure(figsize=(10, 6))
plt.plot(days, company_a, marker="o", label="Company A")
plt.plot(days, company_b, marker="o", label="Company B")
plt.plot(days, company_c, marker="o", label="Company C")
plt.title("Stock Market Analysis")
plt.xlabel("Day")
plt.ylabel("Closing Price")
plt.legend()
plt.grid(True)
plt.show()
print("Overall Growth:")
for company, value in growth.items():
    print(f"{company}: {value:.2f}%")
print("\nCompany with highest overall growth:")
print(highest_company)
print(f"Growth: {growth[highest_company]:.2f}%")
