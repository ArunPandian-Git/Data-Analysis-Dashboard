# House Price Prediction: (Scatter & Line Plot)

house_size = np.array([800, 1000, 1200, 1500, 1800, 2000, 2200, 2500])
house_price = np.array([50,80,120,150,180,200,230,250])
m, b = np.polyfit(house_size, house_price, 1)
trend_line = m * house_size + b
plt.scatter(house_size, house_price, label="House Data")
plt.plot(house_size, trend_line, label="Trend Line")
plt.xlabel("House Size (sq ft)")
plt.ylabel("House Price (₹ Lakhs)")
plt.title("House Price Prediction")
plt.legend()
plt.grid(True)
plt.show()
